# ==============================================================================
# Environment & Secrets (NEVER COMMIT THESE)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ==============================================================================
# Go Backend
# ==============================================================================
# Compiled binaries and executables
*.exe
*.exe-
*.dll
*.so
*.dylib
/bin/
/dist/
main
server
app

# Go test output & coverage
*.test
*.out
coverage.txt

# Vendor folder (uncomment if you don't want to commit vendored dependencies)
# /vendor/

# ==============================================================================
# Node.js / React Frontend
# ==============================================================================
# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Frontend Production Builds
/dist
/build
/.next/
/.nuxt/

# Logs & Caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.vite/

# ==============================================================================
# Uploads & User Media
# ==============================================================================
/uploads/*
!/uploads/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep
/storage/*
!/storage/.gitkeep

# ==============================================================================
# Operating System & IDEs
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

